# ============================================================
#  FIREBASE CONFIGURATION — Portfolio Admin Panel
#  Salin file ini menjadi .env lalu isi dengan nilai asli
#  dari Firebase Console kamu.
#
#  Cara mendapatkan nilai ini:
#  1. Buka https://console.firebase.google.com
#  2. Pilih project kamu
#  3. Klik ikon ⚙️ (Project Settings) → General
#  4. Scroll ke bawah → "Your apps" → pilih Web App (</>)
#  5. Copy nilai dari firebaseConfig
# ============================================================

# --- Firebase Core ---
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
FIREBASE_APP_ID=your_app_id_here

# --- Admin Whitelist ---
# Email Google yang diizinkan mengakses halaman admin
# Pisahkan dengan koma jika lebih dari satu
# Contoh: ADMIN_EMAILS=ario@gmail.com,admin@example.com
ADMIN_EMAILS=your_email@gmail.com
